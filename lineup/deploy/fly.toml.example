# fly launch --no-deploy  (then copy settings), fly volumes create lineup_data --size 1
app = "your-app-name"
primary_region = "yyz"

[build]

[env]
  APP_URL = "https://your-domain.ca"

[[mounts]]
  source = "lineup_data"
  destination = "/data"

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = "off"   # keep running so scheduled emails/texts fire
  min_machines_running = 1

# Secrets: see deploy/DEPLOY.md
