# Copy to .github/workflows/lineup-cron.yml in the repo that holds the app, and set repo secrets
# LINEUP_URL (e.g. https://your-domain.ca) and CRON_SECRET. Runs the hourly job that sends requests/reminders/spares/summaries.
name: lineup-cron
on:
  schedule: [{ cron: "7 * * * *" }]
  workflow_dispatch:
jobs:
  tick:
    runs-on: ubuntu-latest
    steps:
      - run: curl -fsS "${{ secrets.LINEUP_URL }}/api/cron?key=${{ secrets.CRON_SECRET }}"
