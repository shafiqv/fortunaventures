# Public URL of the deployed app (used in email/SMS links)
APP_URL=http://localhost:3000
# Long random string used to sign login cookies
SESSION_SECRET=change-me
# Secret that the scheduler sends to /api/cron  (e.g. ?key=...)
CRON_SECRET=change-me
# SQLite file location (put on a persistent disk in production)
DATABASE_PATH=./data/lineup.db

# Email via Resend (https://resend.com). Without these, emails print to the server console.
RESEND_API_KEY=
EMAIL_FROM=Lineup <no-reply@yourdomain.com>

# SMS via Twilio. Without these, texts print to the server console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1XXXXXXXXXX
